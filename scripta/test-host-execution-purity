#!/usr/bin/env bash
# HEP-2 proof: new target source fails, and a removed debt row lowers the ledger.
# Fixture proofs run first; the live-tree green check runs last so a red tree
# cannot mask the fixture results.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CHECK="$ROOT/scripta/check-host-execution-purity"
FIXTURES="$ROOT/scripta/fixtures/host-execution-purity"

set +e
red_output="$("$CHECK" \
  --fixture \
  --root "$FIXTURES/red-target-source" \
  --ledger "$FIXTURES/red-target-source-ledger.toml" 2>&1)"
red_status=$?
set -e
if [[ "$red_status" -eq 0 ]]; then
  printf '%s\n' "host-execution-purity test: red target-source fixture passed" >&2
  exit 1
fi
if [[ "$red_output" != *"unallowlisted target-source literal"* ]]; then
  printf '%s\n' "host-execution-purity test: red fixture failed for the wrong reason" >&2
  printf '%s\n' "$red_output" >&2
  exit 1
fi

retired_output="$("$CHECK" \
  --fixture \
  --root "$FIXTURES/retired-debt" \
  --ledger "$FIXTURES/retired-debt-ledger.toml" \
  --previous-ledger "$FIXTURES/retired-debt-previous-ledger.toml")"
if [[ "$retired_output" != *"debt-count=1"* || "$retired_output" != *"(lower from 2)"* ]]; then
  printf '%s\n' "host-execution-purity test: retired debt did not lower the ledger" >&2
  printf '%s\n' "$retired_output" >&2
  exit 1
fi

"$CHECK" \
  --fixture \
  --root "$FIXTURES/known-debt-vocabulary" \
  --ledger "$FIXTURES/known-debt-vocabulary-ledger.toml" >/dev/null

set +e
red_vocab_output="$("$CHECK" \
  --fixture \
  --root "$FIXTURES/unledgered-vocabulary" \
  --ledger "$FIXTURES/unledgered-vocabulary-ledger.toml" 2>&1)"
red_vocab_status=$?
set -e
if [[ "$red_vocab_status" -eq 0 ]]; then
  printf '%s\n' "host-execution-purity test: unledgered vocabulary fixture passed" >&2
  exit 1
fi
if [[ "$red_vocab_output" != *"new model or descriptor reconstruction"* ]]; then
  printf '%s\n' "host-execution-purity test: unledgered fixture failed for the wrong reason" >&2
  printf '%s\n' "$red_vocab_output" >&2
  exit 1
fi

# Baseline-token exemption, both directions: the same token passes in the path
# where it exists at the frozen baseline and fails in a path where it does not.
set +e
no_baseline_output="$("$CHECK" \
  --fixture \
  --root "$FIXTURES/baseline-token-vocabulary" \
  --ledger "$FIXTURES/baseline-token-vocabulary-ledger.toml" 2>&1)"
no_baseline_status=$?
set -e
if [[ "$no_baseline_status" -eq 0 ]]; then
  printf '%s\n' "host-execution-purity test: baseline-token fixture passed without a baseline" >&2
  exit 1
fi
if [[ "$no_baseline_output" != *"new operation/model vocabulary"* ]]; then
  printf '%s\n' "host-execution-purity test: no-baseline fixture failed for the wrong reason" >&2
  printf '%s\n' "$no_baseline_output" >&2
  exit 1
fi

"$CHECK" \
  --fixture \
  --root "$FIXTURES/baseline-token-vocabulary" \
  --ledger "$FIXTURES/baseline-token-vocabulary-ledger.toml" \
  --baseline-dir "$FIXTURES/baseline-token-vocabulary-baseline" >/dev/null

set +e
new_path_output="$("$CHECK" \
  --fixture \
  --root "$FIXTURES/baseline-token-new-path" \
  --ledger "$FIXTURES/baseline-token-new-path-ledger.toml" \
  --baseline-dir "$FIXTURES/baseline-token-new-path-baseline" 2>&1)"
new_path_status=$?
set -e
if [[ "$new_path_status" -eq 0 ]]; then
  printf '%s\n' "host-execution-purity test: baseline-token new-path fixture passed" >&2
  exit 1
fi
if [[ "$new_path_output" != *"new operation/model vocabulary"* ]] \
  || [[ "$new_path_output" != *"caller.rs"* ]] \
  || [[ "$new_path_output" == *"driver.rs"* ]]; then
  printf '%s\n' "host-execution-purity test: new-path fixture failed for the wrong reason" >&2
  printf '%s\n' "$new_path_output" >&2
  exit 1
fi

"$CHECK"

printf '%s\n' "host-execution-purity test: red fixture, debt reduction, vocabulary narrowing, baseline-token exemption, and live tree green"
