    {"route": "aleator:octetos", "summary": "Return cryptographic random bytes.", "opener": "numerus", "result": "octeti"},
    {"route": "aleator:uuid", "summary": "Return a UUID v4 string.", "opener": "vacuum", "result": "textus"},
    {"route": "aleator:semina", "summary": "Seed pseudo-random generation.", "opener": "numerus", "result": "vacuum"}
  ],
  "native_dependencies": []
}
