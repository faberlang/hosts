{
  "manifest_version": 1,
  "provider": "tempus",
  "owner": "faberlang",
  "prefixes": ["tempus"],
  "calls": [
    {"route": "tempus:nunc", "summary": "Return the current wall-clock instant at nanosecond precision.", "opener": "vacuum", "result": "instans<ns>"},
    {"route": "tempus:monotonicum", "summary": "Return monotonic nanoseconds.", "opener": "vacuum", "result": "numerus"},
    {"route": "tempus:activum", "summary": "Return active nanoseconds.", "opener": "vacuum", "result": "numerus"},
    {"route": "tempus:dormiet", "summary": "Block for a bounded millisecond interval.", "opener": "numerus", "result": "vacuum"}
  ],
  "native_dependencies": []
}
