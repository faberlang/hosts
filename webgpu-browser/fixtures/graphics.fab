+++
locale = "en"
+++

# Browser-host graphics proof. Triga owns the geometry value; this host-owned
# fixture declares the exact source facts consumed by WGSL/reflection emission.

import from "triga:geometry/data" private data

import from "triga:primitives/basic" private basic

@ shader_contract "vertex_layout"
fn vertex_layout_matches(int geo, int index, string source_name, int shader_location, int format_code, int offset_bytes, int stride_bytes, int step_mode_code, int stage_io_role_code) → bool {
    return true
}

@ shader_contract "varying"
fn varying_matches(string source_name, int shader_location, int format_code, int interpolation_code, int stage_io_role_code) → bool {
    return true
}

@ shader_contract "fragment_output"
fn fragment_output_matches(int location, int format_code, int stage_io_role_code) → bool {
    return true
}

@ shader_contract "pipeline"
fn pipeline_matches(int color_target_format_code, int depth_compare_code, int depth_write_enabled_code, int primitive_topology_code, int vertex_count) → bool {
    return true
}

@ shader_contract "resource_binding"
fn resource_binding_matches(int group, int binding, int kind_code, int role_code, int access_code, int element_count, int layout_code, string source_name, int stage_io_role_code) → bool {
    return true
}

@ vertex { }
fn hello_voxel_vertex() → void {
}

@ fragment { }
fn hello_voxel_fragment() → void {
}

main {
    const data.BufferGeometry ∪ null plane ← basic.plane_geometry(2.0, 2.0)
    assert plane not is null else "graphics proof requires valid Triga geometry"
    assert vertex_layout_matches(0, 0, "position", 0, 3, 0, 12, 1, 1) else "position input layout"
    assert vertex_layout_matches(0, 1, "color", 1, 3, 0, 12, 1, 2) else "color input layout"
    assert varying_matches("color", 0, 3, 1, 2) else "vertex-to-fragment color varying"
    assert fragment_output_matches(0, 4, 2) else "fragment color output"
    assert pipeline_matches(1, 1, 1, 1, 36) else "first graphics pipeline"
    assert resource_binding_matches(0, 0, 1, 1, 1, 64, 1, "transform", 3) else "transform resource"
}
